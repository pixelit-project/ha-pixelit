{
  "name": "pixelit-dashboard-card",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "build": "node scripts/build-card.mjs",
    "build:check": "node scripts/build-card.mjs --check",
    "test": "node --conditions=browser --test tests/frontend/*.test.cjs tests/frontend/*.test.mjs",
    "format:card": "prettier --write src/pixelit-card.js scripts/build-card.mjs tests/frontend/*.mjs",
    "format:check": "prettier --check src/pixelit-card.js scripts/build-card.mjs tests/frontend/*.mjs",
    "check": "npm run format:check && npm run build:check && npm test"
  },
  "dependencies": {
    "lit": "3.3.2"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "jsdom": "31.0.1",
    "prettier": "3.10.1"
  }
}
